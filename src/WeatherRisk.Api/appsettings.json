{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WeatherRisk": "Data Source=App_Data/weatherrisk.db"
  },
  "Monitoring": {
    "WindowSeconds": 60,
    "LatencySampleSize": 512
  },
  "HubData": {
    "LookbackYears": 5,
    "WeatherCacheDays": 30,
    "BaselineCacheDays": 30,
    "MaxConcurrentFetches": 4,
    "WarmUpOnStartup": true
  },
  "Llm": {
    "ProviderOrder": [ "Groq", "Gemini" ],
    "Providers": {
      "Groq": {
        "BaseUrl": "https://api.groq.com/openai/v1/",
        "Models": [ "openai/gpt-oss-120b", "openai/gpt-oss-20b", "qwen/qwen3.8-27b" ],
        "ReasoningEffort": "medium",
        "MaxTokens": 1500
      },
      "Gemini": {
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "Models": [ "gemini-2.5-flash" ]
      }
    }
  },
  "Agent": {
    "MaxSteps": 8,
    "HistoryTurns": 6,
    "TimeoutSeconds": 60,
    "MaxMessageLength": 2000
  },
  "Conversations": {
    "MaxConversations": 1000,
    "MaxTurns": 10,
    "IdleMinutes": 60
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Chat": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  }
}
