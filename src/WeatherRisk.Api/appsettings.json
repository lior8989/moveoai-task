{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WeatherRisk": "Data Source=App_Data/weatherrisk.db"
  },
  "Monitoring": {
    "WindowSeconds": 60,
    "LatencySampleSize": 512
  },
  "HubData": {
    "LookbackYears": 5,
    "WeatherCacheDays": 30,
    "BaselineCacheDays": 30,
    "MaxConcurrentFetches": 4,
    "WarmUpOnStartup": true
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  }
}
