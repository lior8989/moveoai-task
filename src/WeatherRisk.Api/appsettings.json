{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WeatherRisk": "Data Source=App_Data/weatherrisk.db"
  },
  "Monitoring": {
    "WindowSeconds": 60,
    "LatencySampleSize": 512
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    }
  }
}
