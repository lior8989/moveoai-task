root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space

[*.cs]
indent_size = 4

[*.{json,props,csproj,slnx,xml}]
indent_size = 2

# EF Core migrations are generated code: exempt from the "every public member documented" rule.
[src/WeatherRisk.Data/Persistence/Migrations/*.cs]
dotnet_diagnostic.CS1591.severity = none
